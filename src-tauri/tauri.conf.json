{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storyworks",
  "version": "0.1.0",
  "identifier": "storyworks",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Storyworks",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A desktop app for writing a book",
    "longDescription": "Storyworks is a local-first desktop app for writing a book: manuscript editor, timelines, world rules, codex, consistency checks, snapshots and export to PDF and DOCX. Everything is stored in plain JSON files in a folder you choose.",
    "copyright": "Copyright (c) 2026 MainSkown",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../licenses/MPL-2.0.txt": "licenses/MPL-2.0.txt"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
