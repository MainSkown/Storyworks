            "text": "EXT. PRZYSTANEK MŁYŃSKA - PÓŹNIEJ"
          }
        ]
      },
      {
        "type": "action",
        "attrs": {
          "id": "s3-e1"
        },
        "content": [
          {
            "type": "text",
            "text": "Marek wyciąga rękę z małym mosiężnym kluczem."
          }
        ]
      },
      {
        "type": "character",
        "attrs": {
          "id": "s3-e2"
        },
        "content": [
          {
            "type": "text",
            "text": "MAREK"
          }
        ]
      },
      {
        "type": "dialogue",
        "attrs": {
          "id": "s3-e3"
        },
        "content": [
          {
            "type": "text",
            "text": "Dom mamy. Jest twój tak samo jak mój.",
            "marks": [
              {
                "type": "comment",
                "attrs": {
                  "commentId": "c1"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "character",
        "attrs": {
          "id": "s3-e4"
        },
        "content": [
          {
            "type": "text",
            "text": "ANNA"
          }
        ]
      },
      {
        "type": "dialogue",
        "attrs": {
          "id": "s3-e5"
        },
        "content": [
          {
            "type": "text",
            "text": "Nie chcę go."
          }
        ]
      },
      {
        "type": "character",
        "attrs": {
          "id": "s3-e6"
        },
        "content": [
          {
            "type": "text",
            "text": "MAREK"
          }
        ]
      },
      {
        "type": "dialogue",
        "attrs": {
          "id": "s3-e7"
        },
        "content": [
          {
            "type": "text",
            "text": "To zachowaj go dla kogoś, kto będzie chciał."
          }
        ]
      },
      {
        "type": "action",
        "attrs": {
          "id": "s3-e8"
        },
        "content": [
          {
            "type": "text",
            "text": "Anna bierze klucz bez słowa. Z ciemności wyjeżdża autobus."
          }
        ]
      },
      {
        "type": "transition",
        "attrs": {
          "id": "s3-e9"
        },
