  "title": "The Log Book",
  "status": "idea",
  "synopsis": "Mara writes the first entry of her own.",
  "povId": "mara",
  "wordCount": 37,
  "content": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "attrs": {
          "id": "s8-p0"
        },
        "content": [
          {
            "type": "text",
            "text": "Mara opened the log book and wrote the date. Under it she wrote: \"Fog. Light kept. Ship saved.\""
          }
        ]
      },
      {
        "type": "paragraph",
        "attrs": {
          "id": "s8-p1"
        },
        "content": [
          {
            "type": "text",
            "text": "She looked at the line for a long time. Then, because it was true, she added her brother's name."
          }
        ]
      }
    ]
  },
