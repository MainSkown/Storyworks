{
  "version": 3,
  "id": "s6",
  "title": "Alone at the Lantern",
  "status": "revising",
  "synopsis": "The flame sputters. Mara remembers the note and feeds it salt oil.",
  "povId": "mara",
  "wordCount": 58,
  "content": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "attrs": {
          "id": "s6-p0"
        },
        "content": [
          {
            "type": "text",
            "text": "While Tobias was out, the flame began to sputter and lean."
          }
        ]
      },
      {
        "type": "paragraph",
        "attrs": {
          "id": "s6-p1"
        },
        "content": [
          {
            "type": "text",
            "text": "Mara remembered the note. She fetched the salt oil from the cellar and fed the Brass Lantern slowly, the way one feeds a nervous animal."
          }
        ]
      },
      {
        "type": "paragraph",
        "attrs": {
          "id": "s6-p2"
        },
        "content": [
          {
            "type": "text",
            "text": "The flame steadied and turned from yellow to white. For the first time the beam went through the fog like a spear."
          }
        ]
      }
    ]
  },
