        },
        "content": [
          {
            "type": "text",
            "text": "Rain drums on the bus shelter. ANNA (30s) sits on her suitcase and reads the timetable for the third time."
          }
        ]
      },
      {
        "type": "action",
        "attrs": {
          "id": "s1-e2"
        },
        "content": [
          {
            "type": "text",
            "text": "A streetlight flickers. Somewhere a dog barks, then stops."
          }
        ]
      }
    ]
