          {
            "type": "text",
            "text": "EXT. MILL ROAD STOP - LATER"
          }
        ]
      },
      {
        "type": "action",
        "attrs": {
          "id": "s3-e1"
        },
        "content": [
          {
            "type": "text",
            "text": "Marek holds out a small brass key."
          }
        ]
      },
      {
        "type": "character",
        "attrs": {
          "id": "s3-e2"
        },
        "content": [
          {
            "type": "text",
            "text": "MAREK"
          }
        ]
      },
      {
        "type": "dialogue",
        "attrs": {
          "id": "s3-e3"
        },
        "content": [
          {
            "type": "text",
            "text": "Mum's house. It is yours as much as mine.",
            "marks": [
              {
                "type": "comment",
                "attrs": {
                  "commentId": "c1"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "character",
        "attrs": {
          "id": "s3-e4"
        },
        "content": [
          {
            "type": "text",
            "text": "ANNA"
          }
        ]
      },
      {
        "type": "dialogue",
        "attrs": {
          "id": "s3-e5"
        },
        "content": [
          {
            "type": "text",
            "text": "I do not want it."
          }
        ]
      },
      {
        "type": "character",
        "attrs": {
          "id": "s3-e6"
        },
        "content": [
          {
            "type": "text",
            "text": "MAREK"
          }
        ]
      },
      {
        "type": "dialogue",
        "attrs": {
          "id": "s3-e7"
        },
        "content": [
          {
            "type": "text",
            "text": "Then keep it for someone who does."
          }
        ]
      },
      {
        "type": "action",
        "attrs": {
          "id": "s3-e8"
        },
        "content": [
          {
            "type": "text",
            "text": "Anna takes the key without a word. A bus swings out of the dark."
          }
        ]
      },
      {
        "type": "transition",
        "attrs": {
          "id": "s3-e9"
        },
        "content": [
          {
            "type": "text",
            "text": "CUT TO:"
          }
        ]
      }
    ]
