        "content": [
          {
            "type": "text",
            "text": "EXT. MILL ROAD STOP - NIGHT"
          }
        ]
      },
      {
        "type": "action",
        "attrs": {
          "id": "s5-e1"
        },
        "content": [
          {
            "type": "text",
            "text": "The red lights of the bus fade into the fog. Marek stands alone, hands in his pockets."
          }
        ]
      },
      {
        "type": "action",
        "attrs": {
          "id": "s5-e2"
        },
        "content": [
          {
            "type": "text",
            "text": "He sits where Anna sat. Under the bench lies a folded note: \"Back on Sunday.\""
          }
        ]
      }
    ]
  },
