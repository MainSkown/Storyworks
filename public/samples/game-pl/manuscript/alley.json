        "content": [
          {
            "type": "text",
            "text": "Wąski zaułek biegnie wzdłuż muru wieży. Przy ziemi wisi obluzowana, zardzewiała krata."
          }
        ]
      },
      {
        "type": "line",
        "attrs": {
          "id": "b7",
          "lineId": "L000007",
          "speakerId": "e-wren",
          "speakerName": null,
          "kind": "speech"
        },
        "content": [
          {
            "type": "text",
            "text": "To nie drzwi, ale wystarczy."
          }
        ]
      },
      {
        "type": "line",
        "attrs": {
          "id": "b8",
          "lineId": "L000008",
          "speakerId": null,
          "speakerName": null,
          "kind": "text"
        },
        "content": [
          {
            "type": "text",
            "text": "Wren przeciska się przez otwór i wychodzi u stóp schodów, bez klucza."
          }
        ]
      }
    ]
  },
